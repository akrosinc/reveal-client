<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Upper boundary line -->
    <View
        android:id="@+id/view_top_border"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/colorPrimary"
        android:layout_marginBottom="4dp" />

    <!-- Label above count input -->
    <TextView
        android:id="@+id/tv_count_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#000000"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Count input row -->
    <LinearLayout
        android:id="@+id/layout_count_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/et_task_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="Number of tasks"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock"
            android:layout_marginStart="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Warning shown when unlocked with existing tasks -->
    <TextView
        android:id="@+id/tv_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ This will cancel existing tasks and create new ones"
        android:textColor="@android:color/holo_orange_dark"
        android:textSize="12sp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Search row -->
    <LinearLayout
        android:id="@+id/layout_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search…"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_clear_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="✕" />

    </LinearLayout>

    <!-- Task list (fixed height for ~3 items, scrollable independently) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_tasks"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="always" />

    <!-- Lower boundary below recycler (visible when tasks exist) -->
    <View
        android:id="@+id/view_recycler_bottom_border"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/colorPrimary"
        android:layout_marginTop="4dp" />

    <!-- Error message shown when save is blocked (e.g. incomplete child tasks) -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="13sp"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="No tasks generated yet"
        android:visibility="gone" />

</LinearLayout>
