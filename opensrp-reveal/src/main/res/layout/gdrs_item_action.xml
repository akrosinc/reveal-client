<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <android.widget.TextView
        android:id="@+id/individualId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="test1"
        android:textSize="16sp"
        android:textStyle="bold" />
    <android.widget.TextView
      android:id="@+id/individualHousehold"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="test1"
      android:textSize="16sp" />
    <android.widget.TextView
        android:id="@+id/individualGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="test1"
        android:textSize="16sp" />




    <android.widget.TextView
        android:id="@+id/individualName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="test1"
        android:textSize="16sp" />

    <android.widget.TextView
        android:id="@+id/individualDob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="test1"
        android:textSize="16sp" />

    <android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="0dp">

        <android.widget.TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Task Creation Date:"
            android:textSize="13sp"
            android:textStyle="italic"/>

        <android.widget.TextView
            android:id="@+id/createdDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="5dp"
            android:text="test1"
            android:textSize="13sp"
            android:textStyle="italic"/>

        <android.widget.TextView
            android:id="@+id/oldTaskMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="5dp"
            android:text="Task is older than 3 days"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone"
            android:textSize="12sp"
            android:textStyle="italic"/>
    </android.widget.LinearLayout>

    <android.widget.Button
        android:id="@+id/actionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/rounded_button"
        android:padding="3dp"

        android:text="e Me" />
</android.widget.LinearLayout>