<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:background="#6200EE"
        android:padding="5dp"> <!-- Set background color here (Purple) -->

        <!-- Title Text -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compound/Household details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true" />

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:contentDescription="Close" />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Label for First Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Structure does not have a compound or household associated. Please capture details"
            android:layout_gravity="start"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"/>

        <!-- EditText for First Row -->
    </LinearLayout>
    <!-- First Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Label for First Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compound Id:"
            android:layout_gravity="start"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"/>

        <!-- EditText for First Row -->
        <EditText
            android:id="@+id/compoundText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter text"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- Second Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Label for Second Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Household Id:"
            android:layout_gravity="start"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"/>

        <!-- EditText for Second Row -->
        <EditText
            android:id="@+id/householdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter text"
            android:textSize="16sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/errorLayout"
        android:visibility="gone">

        <!-- Label for Second Row -->
        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Must capture:"
            android:layout_gravity="start"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"
            android:textColor="@color/alert_urgent_red"/>

        <!-- EditText for Second Row -->
    </LinearLayout>
    <Button
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_gravity="center"
        android:layout_marginTop="16dp" />

</android.widget.LinearLayout>